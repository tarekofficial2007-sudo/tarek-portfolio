rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.uid == 'xT7fCHmmRBXCtqzQZXzj2aE9DWd2'; }
    match /site/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /admin/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
