rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.uid == 'xT7fCHmmRBXCtqzQZXzj2aE9DWd2'; }
    match /site/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && ((request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024) || (request.resource.contentType == 'application/pdf' && request.resource.size < 10 * 1024 * 1024));
      allow delete: if isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
